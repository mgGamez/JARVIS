# Keep .env private. No key belongs in public/ or a Git commit.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Image models can require a paid tier even when text chat is free.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
HOST=127.0.0.1
PORT=3000
# Enable only on your own Windows computer; each app launch requires approval.
ENABLE_DESKTOP_TOOLS=false
# Optional Gmail Web application OAuth client. See INTEGRATIONS.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/mail/callback
# Required before binding to a non-loopback host. Browser username is jarvis.
# Use only with trusted HTTPS for access across a network.
JARVIS_PASSWORD=
# Comma-separated hostnames only, without scheme/port; needed for remote proxy use.
JARVIS_ALLOWED_HOSTS=
