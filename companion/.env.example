# Address of your own JARVIS brain. Remote addresses must use trusted HTTPS.
JARVIS_BRAIN_URL=http://localhost:3000
# Generate in Devices > Pair computer. Never commit the real token.
JARVIS_DEVICE_TOKEN=
# Explicit browser domain allowlist; commas, no schemes. Add sites you intend to use.
COMPANION_ALLOWED_HOSTS=example.com
# Keep false for normal visible browser use. Headless mode is for controlled testing.
COMPANION_HEADLESS=false
# Optional installed Chrome/Chromium path, e.g. C:\Program Files\Google\Chrome\Application\chrome.exe
COMPANION_CHROME_PATH=
# Opt-in fixed Windows apps; never arbitrary shell commands.
ENABLE_DESKTOP_TOOLS=false

# Optional: dedicated folder for approved text-file reads. No file write/delete.
COMPANION_FILES_ROOT=

# Optional read-only developer tools (Git/Docker must be installed locally).
COMPANION_REPO_ROOT=
ENABLE_DOCKER_TOOLS=false
